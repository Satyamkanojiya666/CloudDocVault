# Copy to .env for local use. On AWS set these as Elastic Beanstalk environment properties.
# Never commit real values.
SECRET_KEY=change-me-to-a-long-random-string
# Leave DATABASE_URL empty to use local SQLite. On AWS: postgresql://USER:PASSWORD@RDS-ENDPOINT:5432/postgres
DATABASE_URL=
# Leave S3_BUCKET empty to store files on local disk. On AWS: your bucket name
S3_BUCKET=
AWS_REGION=ap-south-1
QUOTA_MB=25
